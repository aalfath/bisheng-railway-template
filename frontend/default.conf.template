# Based on the nginx config in dataelement/bisheng-frontend:v3.0.1, adapted for Railway:
# listens on $PORT (IPv4 and IPv6), proxies to the API and RustFS on the private
# network, and answers /health from the API so Railway's health check covers both.
# Upstream names are resolved per request (resolver + variables): a redeployed
# service gets a new private IP, and a name resolved once at start goes stale.
map $http_upgrade $connection_upgrade {
	default upgrade;
	'' close;
}
map $http_x_forwarded_proto $bs_forwarded_proto {
	default $http_x_forwarded_proto;
	"" $scheme;
}
map $http_x_forwarded_host $bs_forwarded_host {
	default $http_x_forwarded_host;
	"" $http_host;
}

server {
	gzip on;
	gzip_comp_level  2;
	gzip_min_length  1000;
	gzip_types  text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml;
	gzip_proxied any;
	gzip_http_version 1.1;
	gzip_vary  on;
	gzip_disable "MSIE [4-6] \.";

	listen __PORT__;
	listen [::]:__PORT__;

	resolver __RESOLVER__ valid=10s;
	set $bisheng_api http://__API_HOST__;
	set $bisheng_s3 http://__S3_ENDPOINT__;

	location = /health {
		proxy_pass $bisheng_api/health;
		proxy_set_header Host $host;
	}

	location / {
		root /usr/share/nginx/html/platform;
		index index.html index.htm;
		location = /index.html {
			add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
		}
		try_files $uri $uri/ /index.html =404;
		add_header X-Frame-Options SAMEORIGIN;
	}

	location /workspace/ {
		alias /usr/share/nginx/html/client/;
		index index.html index.htm;
		location = /workspace/index.html {
			add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
		}
		try_files $uri $uri/ /workspace/index.html;
	}

	# The optional app runtime (hosted apps) is not part of this template:
	# show Bisheng's own "app runtime not enabled" page.
	location /apps/ {
		rewrite ^ /api/v1/apps/_unavailable break;
		proxy_pass $bisheng_api;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	}

	location ~ ^(/workspace)?/api(/|$) {
		rewrite ^/workspace(/.*)$ $1 break;
		proxy_pass $bisheng_api;
		proxy_read_timeout 660s;
		proxy_set_header Host $http_host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $bs_forwarded_proto;
		proxy_set_header X-Forwarded-Host $bs_forwarded_host;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $connection_upgrade;
		client_max_body_size 1024m;
		add_header Access-Control-Allow-Origin $host;
		add_header X-Frame-Options SAMEORIGIN;
	}

	# Presigned file links are signed for the RustFS private host, which nginx
	# sends as the Host header here, so the signatures stay valid.
	location ~ ^/(workspace/bisheng|bisheng|tmp-dir)/ {
		rewrite ^/workspace(/.*)$ $1 break;
		proxy_pass $bisheng_s3;
		client_max_body_size 1024m;
	}
}
